# Data is large and re-downloadable from the official GCS bucket — never commit.
# ANCHORED to the repo root: a bare `data/` would also swallow viz/data/
# (the demo data that ships with the repo — additions there must be visible
# to `git add`, not silently ignored).
/data/
# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
# local scratch
.ab/
viz/data/_debug_*.npy
viz/data/_baseline_*
data/derived/_circuit_full.pkl
# OS
Thumbs.db
.DS_Store
*.bundle
viz/data_smoke/
viz/data/stimuli/ssvep/
bci/ssvep_benchmark/outputs/eeg_f*.npy
bci/ssvep_benchmark/outputs/_trial_*/

# exp019 bulk run artifacts (keep README/summary/figures/report)
experiments/exp019_chemosense/outputs/**/_debug_*
experiments/exp019_chemosense/outputs/**/viz_data.json
experiments/exp019_chemosense/outputs/**/stim_frames.bin
experiments/exp019_chemosense/outputs/*.txt

# exp020 bulk run artifacts (keep README/report/decode logs)
experiments/exp020_proprioception/outputs/**/_debug_*
experiments/exp020_proprioception/outputs/**/viz_data.json
experiments/exp020_proprioception/outputs/**/stim_frames.bin
experiments/exp020_proprioception/outputs/*.txt
